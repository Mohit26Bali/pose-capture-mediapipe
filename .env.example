# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (stores pose keypoint records)
# ---------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pose_capture
PG_USER=postgres
PG_PASSWORD=changeme

# Absolute path to pg_dump.exe / pg_dump (used by the backup job).
# Leave empty to rely on pg_dump being available on PATH.
PG_DUMP_PATH=

# ---------------------------------------------------------------------------
# MongoDB (stores original uploaded images)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pose_capture
MONGO_IMAGE_COLLECTION=images

# Absolute path to mongodump.exe (used by the backup job).
# Leave empty to rely on mongodump being available on PATH.
MONGODUMP_PATH=

# ---------------------------------------------------------------------------
# Python / MediaPipe
# ---------------------------------------------------------------------------
# Absolute path to the python.exe / python binary that has mediapipe installed.
PYTHON_EXECUTABLE=python
POSE_EXTRACTOR_SCRIPT=./python/pose_extractor.py
# Milliseconds to wait for the pose extraction subprocess before killing it.
POSE_EXTRACTION_TIMEOUT_MS=30000
# Path to the PoseLandmarker .task model file (download instructions in README).
# Relative paths are resolved from the backend/ project root.
POSE_LANDMARKER_MODEL_PATH=./python/models/pose_landmarker_full.task
# Max number of people to detect per image.
POSE_MAX_PEOPLE=5
# Confidence thresholds (0-1) for accepting a detected/tracked pose.
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_PRESENCE_CONFIDENCE=0.5

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TMP_DIR=./uploads_tmp

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser requests, e.g.
# "http://localhost:4000,http://localhost:5173". Leave empty/unset to allow
# any origin (fine for local development; tighten before exposing this
# server beyond your own machine).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Backup / Cron
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
# Cron expression for the daily backup. Default = 23:59 every day.
BACKUP_CRON_SCHEDULE=59 23 * * *
BACKUP_TMP_DIR=./backups/tmp
# Backup ZIPs older than this many days are deleted after each successful
# backup run. Set to 0 to disable rotation (keep everything forever).
BACKUP_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Email (Nodemailer / SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=changeme
EMAIL_FROM="Pose Capture Backup <your_email@example.com>"
EMAIL_TO=your_email@example.com
# If the zip exceeds this size (MB), email a note instead of attaching it.
EMAIL_MAX_ATTACHMENT_MB=20

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Shared secret for the API (16+ characters, e.g. from: openssl rand -hex 24).
# When set, every request except /health and the web page itself must send it as
# "Authorization: Bearer <key>" or "x-api-key: <key>". In production the server refuses to
# start without it (unless ALLOW_OPEN_API=true, for a service already protected some other way).
API_KEY=
# ALLOW_OPEN_API=false

# Number of reverse proxies in front of the app (Render = 1). Rate limits believe X-Forwarded-For
# only when this is above 0. Keep 0 when the app is reached directly.
TRUSTED_PROXY_HOPS=0

# Per-visitor limits (defaults shown)
# UPLOADS_PER_MIN=20
# READS_PER_MIN=300
# BACKUPS_PER_HOUR=4

# Refuse images that decode to more than this many megapixels (a tiny file can describe a huge bitmap).
# MAX_IMAGE_MEGAPIXELS=40

# ---------------------------------------------------------------------------
# Pose extraction workers
# ---------------------------------------------------------------------------
# Long-lived Python processes that keep the model loaded (0 = start Python for every image, ~4 s slower).
POSE_WORKERS=2
# Requests allowed to wait for a free worker before the API answers 503.
POSE_QUEUE_MAX=20
# Also scan the image in overlapping crops to find small or distant people.
POSE_TILING=true

# ---------------------------------------------------------------------------
# Backup extras
# ---------------------------------------------------------------------------
# IANA time zone for BACKUP_CRON_SCHEDULE, e.g. Asia/Kolkata. Unset = the server's own zone (UTC on most hosts).
# BACKUP_TIMEZONE=
# The backup contains every uploaded photo. false = email a notification only, never the file.
EMAIL_ATTACH_BACKUP=true
